[Unit]
Description=EWB Live dashboard web server (ewb_live.serve)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__REPO__
# canonical / og:url / og:image base (override with a drop-in; unset -> tags omitted)
Environment=EWB_PUBLIC_URL=https://ewb.espr.ai
ExecStart=__REPO__/.venv/bin/python -m ewb_live.serve --port 8050 --host 0.0.0.0
Restart=always
RestartSec=3
StandardOutput=append:__REPO__/logs/web.log
StandardError=append:__REPO__/logs/web.log

[Install]
WantedBy=__WANTED_BY__
